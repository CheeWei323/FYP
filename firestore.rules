rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------------------------------------------------
    // ROLE / OWNERSHIP HELPERS
    // -----------------------------------------------------------------------

    // Checks whether the authenticated account has the traveller role.
    function isTraveller() {
      return request.auth != null
             && get(
               /databases/$(database)/documents/users/$(request.auth.uid)
             ).data.role == 'traveller';
    }

    // Checks whether the authenticated account has the Content Manager role.
    function isContentManager() {
      return request.auth != null
             && get(
               /databases/$(database)/documents/users/$(request.auth.uid)
             ).data.role == 'contentManager';
    }

    // Checks whether the authenticated account has the Administrator role.
    function isAdmin() {
      return request.auth != null
             && get(
               /databases/$(database)/documents/users/$(request.auth.uid)
            ).data.role == 'admin';
}

    // Checks whether the authenticated account has
   // the Tourism Data Analyst role.
   function isAnalyst() {
      return request.auth != null
             && get(
               /databases/$(database)/documents/users/$(request.auth.uid)
            ).data.role == 'analyst';
}

    // Checks whether the authenticated user owns the selected trip.
    function ownsTrip(tripId) {
      return request.auth != null
             && get(
               /databases/$(database)/documents/trips/$(tripId)
             ).data.userId == request.auth.uid;
    }

    // Roles that may be assigned through Administrator user management.
   // Administrator access is provisioned separately and cannot be granted
  // through the client application.
   function isAssignableRole(role) {
     return role in [
       'traveller',
       'contentManager',
       'analyst'
  ];
}

    // Validate a place ID and its preceding visit while allowing return trips.
    function validRouteVisit(ids, index) {
      return ids.size() <= index
             || (
               ids[index] is string
               && ids[index].matches('^[A-Za-z0-9_-]{1,512}$')
               && (
                 index == 0
                 || ids[index] != ids[index - 1]
               )
             );
    }

    // Store only traveller choices for the current trip destination.
    function validRoutePlan(data, tripId) {
      return data.keys().hasAll([
               'schemaVersion',
               'countryId',
               'travelMode',
               'placeIds',
               'updatedAt'
             ])
             && data.keys().hasOnly([
               'schemaVersion',
               'countryId',
               'travelMode',
               'placeIds',
               'updatedAt'
             ])
             && data.schemaVersion == 1
             && data.countryId is string
             && data.countryId == getAfter(
               /databases/$(database)/documents/trips/$(tripId)
             ).data.destinationCountryId
             && data.travelMode in ['DRIVE', 'WALK']
             && data.placeIds is list
             && data.placeIds.size() >= 2
             && data.placeIds.size() <= 7
             && validRouteVisit(data.placeIds, 0)
             && validRouteVisit(data.placeIds, 1)
             && validRouteVisit(data.placeIds, 2)
             && validRouteVisit(data.placeIds, 3)
             && validRouteVisit(data.placeIds, 4)
             && validRouteVisit(data.placeIds, 5)
             && validRouteVisit(data.placeIds, 6)
             && data.updatedAt == request.time;
    }


    // -----------------------------------------------------------------------
    // DATA VALIDATION HELPERS
    // -----------------------------------------------------------------------

    // Validates the structure of a traveller trip.
    function validTripData(data) {
      return data.keys().hasAll([
               'userId',
               'destinationCountryId',
               'purpose',
               'durationDays',
               'departureDate',
               'createdAt',
               'updatedAt'
             ])
             && data.keys().hasOnly([
               'userId',
               'destinationCountryId',
               'purpose',
               'durationDays',
               'departureDate',
               'createdAt',
               'updatedAt'
             ])
             && data.userId is string
             && data.destinationCountryId is string
             && data.destinationCountryId.size() > 0
             && data.purpose in [
               'tourism',
               'business',
               'study'
             ]
             && data.durationDays is int
             && data.durationDays >= 1
             && data.durationDays <= 3650
             && data.departureDate is timestamp
             && data.createdAt is timestamp
             && data.updatedAt is timestamp;
    }

    // Validates generated regulatory checklist data.
    function validChecklistItem(data, itemId) {
      return data.keys().hasAll([
               'sourceRuleId',
               'category',
               'title',
               'checklistLabel',
               'description',
               'mandatory',
               'officialUrl',
               'sourceName',
               'priority',
               'completed',
               'completedAt'
             ])
             && data.keys().hasOnly([
               'sourceRuleId',
               'category',
               'title',
               'checklistLabel',
               'description',
               'mandatory',
               'officialUrl',
               'sourceName',
               'priority',
               'completed',
               'completedAt'
             ])
             && data.sourceRuleId == itemId
             && data.sourceRuleId is string
             && data.category is string
             && data.title is string
             && data.checklistLabel is string
             && data.description is string
             && data.mandatory is bool
             && data.officialUrl is string
             && data.sourceName is string
             && data.priority is int
             && data.completed == false
             && data.completedAt == null;
    }

  // Validates regulatory data maintained by the Content Manager.
  function validTravelRule(data) {
  return data.keys().hasAll([
           'countryId',
           'category',
           'title',
           'checklistLabel',
           'description',
           'purposes',
           'minDurationDays',
           'maxDurationDays',
           'mandatory',
           'officialUrl',
           'sourceName',
           'active',
           'reviewStatus',
           'priority',
           'lastValidatedAt'
         ])
         && data.keys().hasOnly([
           'countryId',
           'category',
           'title',
           'checklistLabel',
           'description',
           'purposes',
           'minDurationDays',
           'maxDurationDays',
           'mandatory',
           'officialUrl',
           'sourceName',
           'active',
           'reviewStatus',
           'priority',
           'lastValidatedAt'
         ])

         // Destination
         && data.countryId is string
         && data.countryId.size() > 0
         && exists(
           /databases/$(database)/documents/countries/$(data.countryId)
         )

         // Rule category
         && data.category in [
           'passport',
           'visa',
           'entry',
           'document',
           'health'
         ]

         // Traveller-facing regulatory information
         && data.title is string
         && data.title.size() > 0

         && data.checklistLabel is string
         && data.checklistLabel.size() > 0

         && data.description is string
         && data.description.size() > 0

         // Travel purposes
         && data.purposes is list
         && data.purposes.size() > 0
         && data.purposes.size() <= 3
         && data.purposes.hasOnly([
           'all',
           'tourism',
           'business',
           'study'
         ])

         // "all" cannot be combined with individual purposes.
         && (
           data.purposes == ['all']
           || !data.purposes.hasAny([
             'all'
           ])
         )

         // Duration
         && data.minDurationDays is int
         && data.minDurationDays >= 1
         && data.minDurationDays <= 3650

         && (
           data.maxDurationDays == null
           || (
             data.maxDurationDays is int
             && data.maxDurationDays >= data.minDurationDays
             && data.maxDurationDays <= 3650
           )
         )

         // Requirement type
         && data.mandatory is bool

         // Official reference
         && data.officialUrl is string
         && data.officialUrl.size() > 0

         && data.sourceName is string
         && data.sourceName.size() > 0

         // Publication status
         && data.active is bool

         // Review workflow
         && data.reviewStatus in [
           'pendingReview',
           'approved',
           'disabled'
         ]

         // Active rules must be approved.
         // Pending or disabled rules must remain inactive.
         && (
           (
             data.active == true
             && data.reviewStatus == 'approved'
           )
           ||
           (
             data.active == false
             && data.reviewStatus in [
               'pendingReview',
               'disabled'
             ]
           )
         )

         // Display priority
         && data.priority is int
         && data.priority >= 0

         // Validation timestamp
         && data.lastValidatedAt is timestamp;
}


    // -----------------------------------------------------------------------
    // USERS
    // -----------------------------------------------------------------------

    match /users/{userId} {

      // Public registration creates Traveller accounts only.
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.role == 'traveller';

      // Users may read their own profile.
     // Administrators may read user profiles for account management.
      allow read: if request.auth != null
                    && (request.auth.uid == userId || isAdmin());

      // Users may update their own profile but cannot change their role.
     // Administrators may change the role of non-administrator accounts.
    // Administrative role changes may modify only the role and updatedAt.
   // Administrator accounts cannot be promoted, demoted or modified
  // through client-side role management.
      allow update: if request.auth != null
                     && (
                       (
                        request.auth.uid == userId
                     && request.resource.data.role
                        == resource.data.role
                )
                ||
                (
                  isAdmin()
                     && request.auth.uid != userId
                     && resource.data.role != 'admin'
                     && isAssignableRole(
                           request.resource.data.role
                     )
                     && request.resource.data
                          .diff(resource.data)
                          .affectedKeys()
                          .hasOnly([
                            'role',
                            'updatedAt'
                       ])
                     && request.resource.data.updatedAt
                         == request.time
                )
              );

      // User accounts are not deleted directly from the client.
      allow delete: if false;
    }


    // -----------------------------------------------------------------------
    // COUNTRIES
    // -----------------------------------------------------------------------

  match /countries/{countryId} {
    // Authenticated users may read destination configuration.
    allow read: if request.auth != null;

   // Administrators may only change destination availability.
   // Country identity fields remain protected.
    allow update: if isAdmin()
                  && request.resource.data
                       .diff(resource.data)
                       .affectedKeys()
                       .hasOnly([
                         'enabled',
                         'lastUpdated'
                       ])
                  && request.resource.data.enabled is bool
                  && request.resource.data.lastUpdated
                      == request.time;

  allow create, delete: if false;
}


    // -----------------------------------------------------------------------
    // TRAVEL REGULATIONS
    // -----------------------------------------------------------------------

    match /travelRules/{ruleId} {

      // Authenticated users may read regulatory information.
      allow read: if request.auth != null;

      // New Content Manager rules must start inactive
      // and remain pending review until explicitly enabled.
      allow create: if isContentManager()
                    && request.resource.data.active == false
                    && request.resource.data.reviewStatus == 'pendingReview'
                    && validTravelRule(
                      request.resource.data
                    );

      // Content Managers may edit or change the publication status
      // of an existing rule. The destination cannot be changed
      allow update: if isContentManager()
                    && request.resource.data.countryId
                       == resource.data.countryId
                    && validTravelRule(
                      request.resource.data
                    );

      // Regulations are retained for traceability.
      // Enable / Disable is used instead of permanent deletion.
      allow delete: if false;
    }

    // -----------------------------------------------------------------------
   // RULE ACTIVITY LOGS
  // -----------------------------------------------------------------------

  match /ruleActivityLogs/{logId} {

  // Content Managers may read the regulatory activity history.
  allow read: if isContentManager();

  // Content Managers may create activity logs only for themselves.
  allow create: if isContentManager()
                && request.resource.data.keys().hasAll([
                  'action',
                  'ruleId',
                  'ruleTitle',
                  'countryId',
                  'performedByUid',
                  'performedByName',
                  'performedByEmail',
                  'timestamp'
                ])
                && request.resource.data.keys().hasOnly([
                  'action',
                  'ruleId',
                  'ruleTitle',
                  'countryId',
                  'performedByUid',
                  'performedByName',
                  'performedByEmail',
                  'timestamp'
                ])

                && request.resource.data.action in [
                  'created',
                  'updated',
                  'enabled',
                  'disabled'
                ]

                && request.resource.data.ruleId is string
                && request.resource.data.ruleId.size() > 0

                && request.resource.data.ruleTitle is string
                && request.resource.data.ruleTitle.size() > 0

                && request.resource.data.countryId is string
                && request.resource.data.countryId.size() > 0

                && request.resource.data.performedByUid
                   == request.auth.uid

                && request.resource.data.performedByName is string
                && request.resource.data.performedByName.size() > 0

                && request.resource.data.performedByEmail is string

                && request.resource.data.timestamp is timestamp;

  // Activity history is immutable.
  allow update, delete: if false;
}

   // -----------------------------------------------------------------------
  // ADMINISTRATIVE ACTIVITY LOGS
 // -----------------------------------------------------------------------

 match /adminActivityLogs/{logId} {

    // Administrative activity is visible only to administrators.
    allow read: if isAdmin();

    // Logs may only be created by the authenticated administrator
    // who performed the administrative action.
    allow create: if isAdmin()
                && request.resource.data.keys().hasAll([
                  'action',
                  'targetId',
                  'targetName',
                  'details',
                  'performedByUid',
                  'performedByName',
                  'performedByEmail',
                  'timestamp'
                ])
                && request.resource.data.keys().hasOnly([
                  'action',
                  'targetId',
                  'targetName',
                  'details',
                  'performedByUid',
                  'performedByName',
                  'performedByEmail',
                  'timestamp'
                ])
                && request.resource.data.action in [
                  'roleChanged',
                  'destinationEnabled',
                  'destinationDisabled'
                ]
                && request.resource.data.targetId is string
                && request.resource.data.targetId.size() > 0
                && request.resource.data.targetName is string
                && request.resource.data.targetName.size() > 0
                && request.resource.data.details is string
                && request.resource.data.details.size() > 0
                && request.resource.data.performedByUid
                   == request.auth.uid
                && request.resource.data.performedByName
                   == get(
                     /databases/$(database)/documents/users/$(request.auth.uid)
                   ).data.fullName
                && request.resource.data.performedByEmail
                   == get(
                     /databases/$(database)/documents/users/$(request.auth.uid)
                   ).data.email
                && request.resource.data.timestamp
                   == request.time;

  // Administrative history is append-only.
  allow update, delete: if false;
}

    // ---------------------------------------------------------------------------
   // ANALYST GENERATED REPORTS
  // ---------------------------------------------------------------------------

match /analystReports/{reportId} {

    // Tourism Data Analysts can create report snapshots
    // only for their own authenticated account.
    allow create: if isAnalyst()
                  && request.resource.data.analystId == request.auth.uid
                  && request.resource.data.keys().hasAll([
                    'reportId',
                    'analystId',
                    'reportType',
                    'reportTitle',
                    'destinationId',
                    'destinationName',
                    'purpose',
                    'purposeLabel',
                    'format',
                    'schemaVersion',
                    'generatedAt',
                    'data'
                  ])
                  && request.resource.data.keys().hasOnly([
                    'reportId',
                    'analystId',
                    'reportType',
                    'reportTitle',
                    'destinationId',
                    'destinationName',
                    'purpose',
                    'purposeLabel',
                    'format',
                    'schemaVersion',
                    'generatedAt',
                    'data'
                  ])
                  && request.resource.data.reportId == reportId
                  && request.resource.data.reportType in [
                    'destinationTrends',
                    'purposeDistribution',
                    'checklistCompletion',
                    'requirementPatterns'
                  ]
                  && request.resource.data.reportTitle is string
                  && request.resource.data.destinationId is string
                  && request.resource.data.destinationName is string
                  && request.resource.data.purpose is string
                  && request.resource.data.purposeLabel is string
                  && request.resource.data.format == 'xlsx'
                  && request.resource.data.schemaVersion == 1
                  && request.resource.data.generatedAt is timestamp
                  && request.resource.data.generatedAt == request.time
                  && request.resource.data.data is map;

    // Analysts can only view their own generated reports.
    allow read: if isAnalyst()
                && resource.data.analystId == request.auth.uid;

    // Historical report snapshots are immutable.
    allow update, delete: if false;
}

   // ---------------------------------------------------------------------------
  // TRAVELLER REMINDERS
 // ---------------------------------------------------------------------------

match /reminders/{reminderId} {

    // Travellers may create reminders only for themselves
    // and only for trips they own.
    allow create: if isTraveller()
                  && request.resource.data.keys().hasAll([
                    'reminderId',
                    'userId',
                    'tripId',
                    'title',
                    'reminderAt',
                    'completed',
                    'notificationId',
                    'createdAt',
                    'updatedAt'
                  ])
                  && request.resource.data.keys().hasOnly([
                    'reminderId',
                    'userId',
                    'tripId',
                    'title',
                    'reminderAt',
                    'completed',
                    'notificationId',
                    'createdAt',
                    'updatedAt'
                  ])
                  && request.resource.data.reminderId == reminderId
                  && request.resource.data.userId == request.auth.uid
                  && request.resource.data.tripId is string
                  && request.resource.data.tripId.size() > 0
                  && ownsTrip(request.resource.data.tripId)
                  && request.resource.data.title is string
                  && request.resource.data.title.size() > 0
                  && request.resource.data.title.size() <= 120
                  && request.resource.data.reminderAt is timestamp
                  && request.resource.data.completed == false
                  && request.resource.data.notificationId is int
                  && request.resource.data.notificationId > 0
                  && request.resource.data.createdAt == request.time
                  && request.resource.data.updatedAt == request.time;

    // Travellers may read only their own reminders.
    allow read: if request.auth != null
                && resource.data.userId == request.auth.uid;

    // Travellers may change only reminder content,
   // reminder time and completion state.
    allow update: if isTraveller()
                  && resource.data.userId == request.auth.uid
                  && request.resource.data.userId
                     == resource.data.userId
                  && request.resource.data.tripId
                     == resource.data.tripId
                  && request.resource.data.reminderId
                     == resource.data.reminderId
                  && request.resource.data.notificationId
                     == resource.data.notificationId
                  && request.resource.data.createdAt
                     == resource.data.createdAt
                  && request.resource.data
                       .diff(resource.data)
                       .affectedKeys()
                       .hasOnly([
                         'title',
                         'reminderAt',
                         'completed',
                         'updatedAt'
                       ])
                  && request.resource.data.title is string
                  && request.resource.data.title.size() > 0
                  && request.resource.data.title.size() <= 120
                  && request.resource.data.reminderAt is timestamp
                 && request.resource.data.completed is bool
                  && request.resource.data.updatedAt == request.time;

    // Travellers may delete only their own reminders.
    allow delete: if isTraveller()
                  && resource.data.userId == request.auth.uid;
}

    // -----------------------------------------------------------------------
    // TRIPS
    // -----------------------------------------------------------------------

    match /trips/{tripId} {

      // Traveller may create only their own valid trip.
      allow create: if isTraveller()
                    && request.resource.data.userId == request.auth.uid
                    && validTripData(
                      request.resource.data
                    );

      // Traveller may read only their own trip.
      allow read: if request.auth != null
                  && (resource.data.userId == request.auth.uid || isAnalyst()
                  );

      // Traveller may edit only trip-planning fields.
      // Ownership and original creation information cannot change.
      allow update: if isTraveller()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId
                       == resource.data.userId
                    && request.resource.data.createdAt
                       == resource.data.createdAt
                    && request.resource.data
                        .diff(resource.data)
                        .affectedKeys()
                        .hasOnly([
                          'destinationCountryId',
                          'purpose',
                          'durationDays',
                          'departureDate',
                          'updatedAt'
                        ])
                    && validTripData(
                      request.resource.data
                    );

      // Traveller may delete only their own trip.
      allow delete: if isTraveller()
                    && resource.data.userId == request.auth.uid;

      // ---------------------------------------------------------------------
      // PRIVATE ROUTE PLAN
      // ---------------------------------------------------------------------
      match /routePlans/{planId} {
        allow read, delete: if planId == 'current'
                            && isTraveller()
                            && ownsTrip(tripId);

        allow create, update: if planId == 'current'
                              && isTraveller()
                              && ownsTrip(tripId)
                              && validRoutePlan(
                                request.resource.data,
                                tripId
                              );
      }

      // ---------------------------------------------------------------------
      // CHECKLIST ITEMS
      // ---------------------------------------------------------------------

      match /checklistItems/{itemId} {

        // Checklist creation is allowed during:
        // 1. initial trip creation, or
        // 2. checklist regeneration for an existing owned trip.
        allow create: if isTraveller()
                      && validChecklistItem(
                        request.resource.data,
                        itemId
                      )
                      && (
                        (
                          !exists(
                            /databases/$(database)/documents/trips/$(tripId)
                          )
                          && getAfter(
                            /databases/$(database)/documents/trips/$(tripId)
                          ).data.userId == request.auth.uid
                        )
                        ||
                        (
                          exists(
                            /databases/$(database)/documents/trips/$(tripId)
                          )
                          && get(
                            /databases/$(database)/documents/trips/$(tripId)
                          ).data.userId == request.auth.uid
                        )
                      );

        // Trip owners may read their own checklist items.
       // Tourism Data Analysts may read checklist items
      // for read-only aggregate completion analytics.
        allow read: if ownsTrip(tripId)
                     || isAnalyst();

        // Travellers may change only completion information.
        allow update: if ownsTrip(tripId)
                      && request.resource.data
                          .diff(resource.data)
                          .affectedKeys()
                          .hasOnly([
                            'completed',
                            'completedAt'
                          ])
                      && request.resource.data.completed is bool;

        // Required for checklist regeneration
        // and whole-trip deletion.
        allow delete: if ownsTrip(tripId);
      }


      // ---------------------------------------------------------------------
      // PACKING ITEMS
      // ---------------------------------------------------------------------

      match /packingItems/{itemId} {

        // Travellers may add packing items only to their own trip.
        allow create: if ownsTrip(tripId)
                      && request.resource.data.keys().hasAll([
                        'name',
                        'category',
                        'quantity',
                        'packed',
                        'source',
                        'createdAt',
                        'updatedAt'
                      ])
                      && request.resource.data.keys().hasOnly([
                        'name',
                        'category',
                        'quantity',
                        'packed',
                        'source',
                        'createdAt',
                        'updatedAt'
                      ])
                      && request.resource.data.name is string
                      && request.resource.data.name.size() > 0
                      && request.resource.data.category in [
                        'clothing',
                        'toiletries',
                        'electronics',
                        'healthComfort',
                        'activityEssentials',
                        'generalEssentials',
                        'other'
                      ]
                      && request.resource.data.quantity is int
                      && request.resource.data.quantity >= 1
                      && request.resource.data.packed is bool
                      && request.resource.data.source in [
                        'ai',
                        'user'
                      ];

        // Packing items are visible only to the trip owner.
        allow read: if ownsTrip(tripId);

        // Travellers may edit packing details and packing status.
        // Original source and creation timestamp cannot be changed.
        allow update: if ownsTrip(tripId)
                      && request.resource.data
                          .diff(resource.data)
                          .affectedKeys()
                          .hasOnly([
                            'name',
                            'category',
                            'quantity',
                            'packed',
                            'updatedAt'
                          ])
                      && request.resource.data.name is string
                      && request.resource.data.name.size() > 0
                      && request.resource.data.category in [
                        'clothing',
                        'toiletries',
                        'electronics',
                        'healthComfort',
                        'activityEssentials',
                        'generalEssentials',
                        'other'
                      ]
                      && request.resource.data.quantity is int
                      && request.resource.data.quantity >= 1
                      && request.resource.data.packed is bool;

        // Packing items are personal and may be removed by the trip owner.
        allow delete: if ownsTrip(tripId);
      }
    }
  }
}