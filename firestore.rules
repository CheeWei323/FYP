rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------------------------------------------------
    // ROLE / OWNERSHIP HELPERS
    // -----------------------------------------------------------------------

    // Checks whether the authenticated account has the traveller role.
    function isTraveller() {
      return request.auth != null
             && get(
               /databases/$(database)/documents/users/$(request.auth.uid)
             ).data.role == 'traveller';
    }

    // Checks whether the authenticated account has the Content Manager role.
    function isContentManager() {
      return request.auth != null
             && get(
               /databases/$(database)/documents/users/$(request.auth.uid)
             ).data.role == 'contentManager';
    }

    // Checks whether the authenticated account has the Administrator role.
    function isAdmin() {
      return request.auth != null
             && get(
               /databases/$(database)/documents/users/$(request.auth.uid)
            ).data.role == 'admin';
}

    // Checks whether the authenticated user owns the selected trip.
    function ownsTrip(tripId) {
      return request.auth != null
             && get(
               /databases/$(database)/documents/trips/$(tripId)
             ).data.userId == request.auth.uid;
    }


    // -----------------------------------------------------------------------
    // DATA VALIDATION HELPERS
    // -----------------------------------------------------------------------

    // Validates the structure of a traveller trip.
    function validTripData(data) {
      return data.keys().hasAll([
               'userId',
               'destinationCountryId',
               'purpose',
               'durationDays',
               'departureDate',
               'createdAt',
               'updatedAt'
             ])
             && data.keys().hasOnly([
               'userId',
               'destinationCountryId',
               'purpose',
               'durationDays',
               'departureDate',
               'createdAt',
               'updatedAt'
             ])
             && data.userId is string
             && data.destinationCountryId is string
             && data.destinationCountryId.size() > 0
             && data.purpose in [
               'tourism',
               'business',
               'study'
             ]
             && data.durationDays is int
             && data.durationDays >= 1
             && data.durationDays <= 3650
             && data.departureDate is timestamp
             && data.createdAt is timestamp
             && data.updatedAt is timestamp;
    }

    // Validates generated regulatory checklist data.
    function validChecklistItem(data, itemId) {
      return data.keys().hasAll([
               'sourceRuleId',
               'category',
               'title',
               'checklistLabel',
               'description',
               'mandatory',
               'officialUrl',
               'sourceName',
               'priority',
               'completed',
               'completedAt'
             ])
             && data.keys().hasOnly([
               'sourceRuleId',
               'category',
               'title',
               'checklistLabel',
               'description',
               'mandatory',
               'officialUrl',
               'sourceName',
               'priority',
               'completed',
               'completedAt'
             ])
             && data.sourceRuleId == itemId
             && data.sourceRuleId is string
             && data.category is string
             && data.title is string
             && data.checklistLabel is string
             && data.description is string
             && data.mandatory is bool
             && data.officialUrl is string
             && data.sourceName is string
             && data.priority is int
             && data.completed == false
             && data.completedAt == null;
    }

  // Validates regulatory data maintained by the Content Manager.
  function validTravelRule(data) {
  return data.keys().hasAll([
           'countryId',
           'category',
           'title',
           'checklistLabel',
           'description',
           'purposes',
           'minDurationDays',
           'maxDurationDays',
           'mandatory',
           'officialUrl',
           'sourceName',
           'active',
           'reviewStatus',
           'priority',
           'lastValidatedAt'
         ])
         && data.keys().hasOnly([
           'countryId',
           'category',
           'title',
           'checklistLabel',
           'description',
           'purposes',
           'minDurationDays',
           'maxDurationDays',
           'mandatory',
           'officialUrl',
           'sourceName',
           'active',
           'reviewStatus',
           'priority',
           'lastValidatedAt'
         ])

         // Destination
         && data.countryId is string
         && data.countryId.size() > 0
         && exists(
           /databases/$(database)/documents/countries/$(data.countryId)
         )

         // Rule category
         && data.category in [
           'passport',
           'visa',
           'entry',
           'document',
           'health'
         ]

         // Traveller-facing regulatory information
         && data.title is string
         && data.title.size() > 0

         && data.checklistLabel is string
         && data.checklistLabel.size() > 0

         && data.description is string
         && data.description.size() > 0

         // Travel purposes
         && data.purposes is list
         && data.purposes.size() > 0
         && data.purposes.size() <= 3
         && data.purposes.hasOnly([
           'all',
           'tourism',
           'business',
           'study'
         ])

         // "all" cannot be combined with individual purposes.
         && (
           data.purposes == ['all']
           || !data.purposes.hasAny([
             'all'
           ])
         )

         // Duration
         && data.minDurationDays is int
         && data.minDurationDays >= 1
         && data.minDurationDays <= 3650

         && (
           data.maxDurationDays == null
           || (
             data.maxDurationDays is int
             && data.maxDurationDays >= data.minDurationDays
             && data.maxDurationDays <= 3650
           )
         )

         // Requirement type
         && data.mandatory is bool

         // Official reference
         && data.officialUrl is string
         && data.officialUrl.size() > 0

         && data.sourceName is string
         && data.sourceName.size() > 0

         // Publication status
         && data.active is bool

         // Review workflow
         && data.reviewStatus in [
           'pendingReview',
           'approved',
           'disabled'
         ]

         // Active rules must be approved.
         // Pending or disabled rules must remain inactive.
         && (
           (
             data.active == true
             && data.reviewStatus == 'approved'
           )
           ||
           (
             data.active == false
             && data.reviewStatus in [
               'pendingReview',
               'disabled'
             ]
           )
         )

         // Display priority
         && data.priority is int
         && data.priority >= 0

         // Validation timestamp
         && data.lastValidatedAt is timestamp;
}


    // -----------------------------------------------------------------------
    // USERS
    // -----------------------------------------------------------------------

    match /users/{userId} {

      // Public registration creates Traveller accounts only.
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.role == 'traveller';

      // Users may read their own profile.
     // Administrators may read user profiles for account management.
      allow read: if request.auth != null
                    && (request.auth.uid == userId || isAdmin());

      // Users may update their own profile but cannot change their role.
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.role == resource.data.role;

      // User accounts are not deleted directly from the client.
      allow delete: if false;
    }


    // -----------------------------------------------------------------------
    // COUNTRIES
    // -----------------------------------------------------------------------

    match /countries/{countryId} {

      // Authenticated users may read supported destination information.
      allow read: if request.auth != null;

      // Country management is not yet enabled.
      allow write: if false;
    }


    // -----------------------------------------------------------------------
    // TRAVEL REGULATIONS
    // -----------------------------------------------------------------------

    match /travelRules/{ruleId} {

      // Authenticated users may read regulatory information.
      allow read: if request.auth != null;

      // New Content Manager rules must start inactive
      // and remain pending review until explicitly enabled.
      allow create: if isContentManager()
                    && request.resource.data.active == false
                    && request.resource.data.reviewStatus == 'pendingReview'
                    && validTravelRule(
                      request.resource.data
                    );

      // Content Managers may edit or change the publication status
      // of an existing rule. The destination cannot be changed
      allow update: if isContentManager()
                    && request.resource.data.countryId
                       == resource.data.countryId
                    && validTravelRule(
                      request.resource.data
                    );

      // Regulations are retained for traceability.
      // Enable / Disable is used instead of permanent deletion.
      allow delete: if false;
    }

    // -----------------------------------------------------------------------
   // RULE ACTIVITY LOGS
  // -----------------------------------------------------------------------

  match /ruleActivityLogs/{logId} {

  // Content Managers may read the regulatory activity history.
  allow read: if isContentManager();

  // Content Managers may create activity logs only for themselves.
  allow create: if isContentManager()
                && request.resource.data.keys().hasAll([
                  'action',
                  'ruleId',
                  'ruleTitle',
                  'countryId',
                  'performedByUid',
                  'performedByName',
                  'performedByEmail',
                  'timestamp'
                ])
                && request.resource.data.keys().hasOnly([
                  'action',
                  'ruleId',
                  'ruleTitle',
                  'countryId',
                  'performedByUid',
                  'performedByName',
                  'performedByEmail',
                  'timestamp'
                ])

                && request.resource.data.action in [
                  'created',
                  'updated',
                  'enabled',
                  'disabled'
                ]

                && request.resource.data.ruleId is string
                && request.resource.data.ruleId.size() > 0

                && request.resource.data.ruleTitle is string
                && request.resource.data.ruleTitle.size() > 0

                && request.resource.data.countryId is string
                && request.resource.data.countryId.size() > 0

                && request.resource.data.performedByUid
                   == request.auth.uid

                && request.resource.data.performedByName is string
                && request.resource.data.performedByName.size() > 0

                && request.resource.data.performedByEmail is string

                && request.resource.data.timestamp is timestamp;

  // Activity history is immutable.
  allow update, delete: if false;
}

    // -----------------------------------------------------------------------
    // TRIPS
    // -----------------------------------------------------------------------

    match /trips/{tripId} {

      // Traveller may create only their own valid trip.
      allow create: if isTraveller()
                    && request.resource.data.userId == request.auth.uid
                    && validTripData(
                      request.resource.data
                    );

      // Traveller may read only their own trip.
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;

      // Traveller may edit only trip-planning fields.
      // Ownership and original creation information cannot change.
      allow update: if isTraveller()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId
                       == resource.data.userId
                    && request.resource.data.createdAt
                       == resource.data.createdAt
                    && request.resource.data
                        .diff(resource.data)
                        .affectedKeys()
                        .hasOnly([
                          'destinationCountryId',
                          'purpose',
                          'durationDays',
                          'departureDate',
                          'updatedAt'
                        ])
                    && validTripData(
                      request.resource.data
                    );

      // Traveller may delete only their own trip.
      allow delete: if isTraveller()
                    && resource.data.userId == request.auth.uid;


      // ---------------------------------------------------------------------
      // CHECKLIST ITEMS
      // ---------------------------------------------------------------------

      match /checklistItems/{itemId} {

        // Checklist creation is allowed during:
        // 1. initial trip creation, or
        // 2. checklist regeneration for an existing owned trip.
        allow create: if isTraveller()
                      && validChecklistItem(
                        request.resource.data,
                        itemId
                      )
                      && (
                        (
                          !exists(
                            /databases/$(database)/documents/trips/$(tripId)
                          )
                          && getAfter(
                            /databases/$(database)/documents/trips/$(tripId)
                          ).data.userId == request.auth.uid
                        )
                        ||
                        (
                          exists(
                            /databases/$(database)/documents/trips/$(tripId)
                          )
                          && get(
                            /databases/$(database)/documents/trips/$(tripId)
                          ).data.userId == request.auth.uid
                        )
                      );

        // Checklist items are visible only to the trip owner.
        allow read: if ownsTrip(tripId);

        // Travellers may change only completion information.
        allow update: if ownsTrip(tripId)
                      && request.resource.data
                          .diff(resource.data)
                          .affectedKeys()
                          .hasOnly([
                            'completed',
                            'completedAt'
                          ])
                      && request.resource.data.completed is bool;

        // Required for checklist regeneration
        // and whole-trip deletion.
        allow delete: if ownsTrip(tripId);
      }


      // ---------------------------------------------------------------------
      // PACKING ITEMS
      // ---------------------------------------------------------------------

      match /packingItems/{itemId} {

        // Travellers may add packing items only to their own trip.
        allow create: if ownsTrip(tripId)
                      && request.resource.data.keys().hasAll([
                        'name',
                        'category',
                        'quantity',
                        'packed',
                        'source',
                        'createdAt',
                        'updatedAt'
                      ])
                      && request.resource.data.keys().hasOnly([
                        'name',
                        'category',
                        'quantity',
                        'packed',
                        'source',
                        'createdAt',
                        'updatedAt'
                      ])
                      && request.resource.data.name is string
                      && request.resource.data.name.size() > 0
                      && request.resource.data.category in [
                        'clothing',
                        'toiletries',
                        'electronics',
                        'healthComfort',
                        'activityEssentials',
                        'generalEssentials',
                        'other'
                      ]
                      && request.resource.data.quantity is int
                      && request.resource.data.quantity >= 1
                      && request.resource.data.packed is bool
                      && request.resource.data.source in [
                        'ai',
                        'user'
                      ];

        // Packing items are visible only to the trip owner.
        allow read: if ownsTrip(tripId);

        // Travellers may edit packing details and packing status.
        // Original source and creation timestamp cannot be changed.
        allow update: if ownsTrip(tripId)
                      && request.resource.data
                          .diff(resource.data)
                          .affectedKeys()
                          .hasOnly([
                            'name',
                            'category',
                            'quantity',
                            'packed',
                            'updatedAt'
                          ])
                      && request.resource.data.name is string
                      && request.resource.data.name.size() > 0
                      && request.resource.data.category in [
                        'clothing',
                        'toiletries',
                        'electronics',
                        'healthComfort',
                        'activityEssentials',
                        'generalEssentials',
                        'other'
                      ]
                      && request.resource.data.quantity is int
                      && request.resource.data.quantity >= 1
                      && request.resource.data.packed is bool;

        // Packing items are personal and may be removed by the trip owner.
        allow delete: if ownsTrip(tripId);
      }
    }
  }
}